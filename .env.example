# .env.example — todas las claves que leen las settings (backend/app/core/config.py).
# Copialo a .env y completá los valores. .env NUNCA se commitea (SEC-1, GEN-3).
# Este archivo no contiene ningún valor real.

# --- Obligatorias ---------------------------------------------------------------

# development | test | production. Sin default a propósito.
APP_ENV=development
# Cadena de conexión de SQLAlchemy, p. ej. postgresql+psycopg://USUARIO:CLAVE@HOST:PUERTO/BASE
DATABASE_URL=

# --- Opcionales (el valor indicado es el default) -------------------------------

# Loguea todo el SQL. Prohibido en production: expone teléfonos y direcciones (DAT-10).
DATABASE_ECHO=false
# Tope de espera del chequeo de base de GET /health, en segundos.
HEALTH_DB_TIMEOUT_SECONDS=2
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Timeouts del cliente HTTP saliente, en segundos.
HTTP_CONNECT_TIMEOUT_SECONDS=5
HTTP_READ_TIMEOUT_SECONDS=10
HTTP_WRITE_TIMEOUT_SECONDS=10
HTTP_POOL_TIMEOUT_SECONDS=5

# Rutas de los YAML de configuración. Vacío = config/<archivo>.yaml en la raíz del repo.
RESTAURANT_CONFIG_PATH=
MESSAGES_CONFIG_PATH=
HTTP_ERRORS_CONFIG_PATH=
